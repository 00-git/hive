{
  "name": "hive-fed-host",
  "version": "0.1.0",
  "description": "hive federation host dsh plugin: connects to the gateway, advertises caps, executes directed tasks under a local permission gate (whitelist + audit), reports state digests",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "hive",
    "federation",
    "host"
  ],
  "license": "MIT",
  "main": "lib/host/index.js",
  "types": "lib/host/index.d.ts",
  "bin": {
    "hive-fed-host": "./bin/hive-fed-host.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/host/index.d.ts",
      "default": "./lib/host/index.js"
    },
    "./standalone": {
      "types": "./lib/host/standalone.d.ts",
      "default": "./lib/host/standalone.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "bin/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "tsdown && node build-client.mjs"
  },
  "dependencies": {
    "hive-fed-protocol": "file:../fed-protocol",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.25.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
